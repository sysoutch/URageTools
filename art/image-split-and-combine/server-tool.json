{
  "id": "art__image-split-and-combine",
  "title": "Image Split And Combine",
  "description": "Split a URage image into individually downloadable grid tiles. Combining multiple sources remains a separate client workflow.",
  "action": "imageSplit",
  "inputSchema": {
    "type": "object",
    "required": ["imageId", "imageFileName", "columns", "rows"],
    "properties": {
      "imageId": { "type": "string" },
      "imageFileName": { "type": "string" },
      "columns": { "type": "integer", "minimum": 1, "maximum": 8 },
      "rows": { "type": "integer", "minimum": 1, "maximum": 8 },
      "offsetX": { "type": "integer", "minimum": 0, "default": 0 },
      "offsetY": { "type": "integer", "minimum": 0, "default": 0 },
      "format": { "type": "string", "enum": ["png", "jpeg", "webp"], "default": "png" },
      "quality": { "type": "number", "minimum": 10, "maximum": 100, "default": 92 }
    }
  }
}